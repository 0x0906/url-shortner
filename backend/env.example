PORT=5000
DATABASE_URL=postgresql://postgres:123@localhost:5432/url_shortener
JWT_SECRET=mySuperSecretKeyForJwtTokenGenerationThatIsLongEnough123456
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
RATE_LIMIT_API_MAX=150
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=900000
CACHE_MAX_SIZE=500

# Option 1: Resend (Recommended for Render Free Tier - uses HTTPS, no port blocking)
# Sign up at resend.com to get your free API key
RESEND_API_KEY=

# Option 2: SMTP (For local dev or hosting that doesn't block port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TrimURL <noreply@trimurl.com>
